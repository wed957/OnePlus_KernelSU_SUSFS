+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.eltavine.duckdetector.diagnostics
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.assertThrows
+import org.junit.Test
+
+class DiagnosticStoreTest {
+    private var now = 1_000L
+    private val store = DiagnosticStore({ now }, { 10_000L + now })
+    private fun result(id: String = "selinux", ready: Boolean = true, report: String = "observed details") =
+        DiagnosticSnapshot(id, id, ready, "INFO", "Measured result", report)
+    private fun DiagnosticStore.request(target: String): DiagnosticRequest =
+        request(if (target == "all") DiagnosticSelection.All else DiagnosticSelection.Single(target))
+
+    @Test
+    fun requestRequiresTheExistingAppSession() {
+        assertEquals(DiagnosticRequestStatus.NOT_READY, store.request("all").status)
+        store.attach(listOf(result()))
+        store.detach()
+        assertEquals(DiagnosticRequestStatus.NOT_READY, store.request("selinux").status)
+        assertFalse(store.read(0).attached)
+    }
+
+    @Test
+    fun unknownTargetDoesNotStartOrMutateAValidScan() {
+        store.attach(listOf(result()))
+        assertEquals(DiagnosticRequestStatus.UNKNOWN_DETECTOR, store.request("../selinux").status)
+        assertTrue(store.status().single().ready)
+        assertEquals("observed details", store.status().single().report)
+    }
+
+    @Test
+    fun queuedRequestReservesTheSessionBeforeTheMainThreadStartsIt() {
+        store.attach(listOf(result(), result("nativeroot")))
+        val request = store.request("selinux")
+        assertEquals(DiagnosticRequestStatus.QUEUED, request.status)
+        assertEquals(listOf("selinux"), request.detectorIds)
+        assertEquals(DiagnosticRequestStatus.BUSY, store.request("selinux").status)
+        assertEquals(DiagnosticRequestStatus.BUSY, store.request("nativeroot").status)
+        assertEquals("", store.status().first().report)
+        assertEquals("queued", store.status().first().phase)
+    }
+
+    @Test
+    fun otherRunningDetectorsPreventTimingInterferenceFromNewRequests() {
+        store.attach(listOf(result(), result("nativeroot", ready = false)))
+        assertEquals(DiagnosticRequestStatus.BUSY, store.request("selinux").status)
+        assertTrue(store.status().first().ready)
+    }
+
+    @Test
+    fun completionKeepsTheRequestIdentityAndMeasuredDuration() {
+        store.attach(listOf(result()))
+        val request = store.request("all")
+        now = 1_100L
+        store.started("selinux")
+        now = 1_350L
+        store.update(result(report = "NO_SIGNAL; median=0 ns"))
+        val complete = store.status().single()
+        assertEquals("completed", complete.phase)
+        assertEquals(request.requestId, complete.requestId)
+        assertEquals(250L, complete.elapsedMillis)
+        assertEquals("NO_SIGNAL; median=0 ns", complete.report)
+        assertEquals(DiagnosticRequestStatus.QUEUED, store.request("selinux").status)
+    }
+
+    @Test
+    fun retainedResultsDoNotClaimAZeroDurationFreshMeasurement() {
+        store.attach(listOf(result()))
+        store.update(result())
+        assertEquals("snapshot", store.status().single().phase)
+        assertNull(store.status().single().elapsedMillis)
+        assertNull(store.status().single().requestId)
+    }
+
+    @Test
+    fun disconnectDoesNotTurnAnIncompleteScanIntoACleanResult() {
+        store.attach(listOf(result()))
+        store.request("all")
+        store.started("selinux")
+        store.detach()
+        val value = store.status().single()
+        assertFalse(value.ready)
+        assertEquals("unavailable", value.phase)
+        assertEquals("", value.report)
+        assertEquals("detached", store.read(0).events.last().type)
+    }
+
+    @Test
+    fun boundedHistoryReportsAGapAndSupportsACursorFromAPreviousProcess() {
+        val bounded = DiagnosticStore({ now }, { now }, eventLimit = 2)
+        bounded.attach(listOf(result()))
+        repeat(3) { bounded.update(result()) }
+        val read = bounded.read(0)
+        assertTrue(read.gap)
+        assertEquals(listOf(3L, 4L), read.events.map { it.sequence })
+        assertTrue(bounded.read(4).events.isEmpty())
+        val reset = bounded.read(100)
+        assertTrue(reset.reset)
+        assertFalse(reset.gap)
+        assertEquals(listOf(3L, 4L), reset.events.map { it.sequence })
+        assertThrows(IllegalArgumentException::class.java) { bounded.read(-1) }
+    }
+
+    @Test
+    fun eventPreviewTruncationDoesNotTruncateTheReportEndpoint() {
+        val report = "x".repeat(DiagnosticStore.EVENT_REPORT_LIMIT + 50)
+        store.attach(listOf(result()))
+        store.update(result(report = report))
+        val event = store.read(0).events.last()
+        assertTrue(event.reportTruncated)
+        assertEquals(DiagnosticStore.EVENT_REPORT_LIMIT, event.snapshot!!.report.length)
+        assertEquals(report, store.status().single().report)
+    }
+
+    @Test
+    fun failedDispatchIsExplicitAndReleasesTheReservation() {
+        store.attach(listOf(result()))
+        store.request("all")
+        store.failed("selinux", "carrier unavailable")
+        assertEquals("error", store.status().single().phase)
+        assertEquals("carrier unavailable", store.status().single().report)
+        assertEquals("INFO", store.status().single().severity)
+        assertEquals(DiagnosticRequestStatus.QUEUED, store.request("all").status)
+    }
+
+    @Test
+    fun callerPolicyRejectsOtherAppsEvenWhenTheyCouldHoldDumpPermission() {
+        for (caller in listOf(0, 2000, 10185)) enforceDiagnosticCaller(true, caller, 10185)
+        for (caller in listOf(1000, 10001, 10365, 99123, 102000)) {
+            assertThrows(SecurityException::class.java) { enforceDiagnosticCaller(true, caller, 10185) }
+        }
+        assertThrows(SecurityException::class.java) { enforceDiagnosticCaller(false, 2000, 10185) }
+    }
+}
