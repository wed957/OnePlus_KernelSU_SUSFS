+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.eltavine.duckdetector.diagnostics
+
+import java.util.UUID
+
+internal data class DiagnosticSnapshot(
+    val id: String,
+    val title: String,
+    val ready: Boolean,
+    val severity: String,
+    val headline: String,
+    val report: String = "",
+    val phase: String = if (ready) "snapshot" else "running",
+    val requestId: Long? = null,
+    val startedAtMillis: Long? = null,
+    val elapsedMillis: Long? = null,
+)
+
+internal data class DiagnosticEvent(
+    val sequence: Long,
+    val epochMillis: Long,
+    val type: String,
+    val snapshot: DiagnosticSnapshot?,
+    val detail: String = "",
+    val reportTruncated: Boolean = false,
+)
+
+internal data class DiagnosticRead(
+    val instance: String,
+    val attached: Boolean,
+    val newestSequence: Long,
+    val oldestSequence: Long,
+    val gap: Boolean,
+    val reset: Boolean,
+    val events: List<DiagnosticEvent>,
+)
+
+internal enum class DiagnosticRequestStatus {
+    NOT_READY, UNKNOWN_DETECTOR, BUSY, QUEUED, UNKNOWN_METHOD,
+}
+
+internal sealed interface DiagnosticSelection {
+    data object All : DiagnosticSelection
+    data class Single(val id: String) : DiagnosticSelection
+}
+
+internal data class DiagnosticRequest(
+    val status: DiagnosticRequestStatus,
+    val message: String,
+    val requestId: Long? = null,
+    val detectorIds: List<String> = emptyList(),
+)
+
+/** A bounded journal of completed windows; no filesystem or work runs inside a probe's hot loop. */
+internal class DiagnosticStore(
+    private val elapsedMillis: () -> Long,
+    private val epochMillis: () -> Long,
+    private val eventLimit: Int = 128,
+) {
+    val instance: String = UUID.randomUUID().toString()
+    private val snapshots = linkedMapOf<String, DiagnosticSnapshot>()
+    private val events = ArrayDeque<DiagnosticEvent>()
+    private var attached = false
+    private var sequence = 0L
+    private var requestSequence = 0L
+
+    init {
+        require(eventLimit > 0)
+    }
+
+    @Synchronized
+    fun attach(initial: List<DiagnosticSnapshot>) {
+        require(initial.map { it.id }.distinct().size == initial.size)
+        snapshots.clear()
+        initial.forEach { snapshots[it.id] = it }
+        attached = true
+        append("attached")
+    }
+
+    @Synchronized
+    fun detach() {
+        attached = false
+        snapshots.replaceAll { _, value ->
+            if (value.ready) value else value.copy(phase = "unavailable", report = "")
+        }
+        append("detached", detail = "Open the app and complete its startup choices to reconnect.")
+    }
+
+    @Synchronized
+    fun request(selection: DiagnosticSelection): DiagnosticRequest {
+        if (!attached) return DiagnosticRequest(DiagnosticRequestStatus.NOT_READY, "Open the app and complete its startup choices.")
+        val ids = when (selection) {
+            DiagnosticSelection.All -> snapshots.keys.toList()
+            is DiagnosticSelection.Single -> listOf(selection.id)
+        }
+        if (ids.isEmpty() || ids.any { it !in snapshots }) {
+            return DiagnosticRequest(DiagnosticRequestStatus.UNKNOWN_DETECTOR, "Use status to list available detector IDs.")
+        }
+        // Even a different detector can perturb timing or share a carrier with the requested one.
+        if (snapshots.values.any { !it.ready }) {
+            return DiagnosticRequest(DiagnosticRequestStatus.BUSY, "Wait for the current scan to finish.")
+        }
+        val requestId = ++requestSequence
+        ids.forEach { id ->
+            val queued = snapshots.getValue(id).copy(
+                ready = false, phase = "queued", report = "", requestId = requestId,
+                startedAtMillis = null, elapsedMillis = null,
+            )
+            snapshots[id] = queued
+            append("queued", queued)
+        }
+        return DiagnosticRequest(DiagnosticRequestStatus.QUEUED, "Request accepted by the active app session.", requestId, ids)
+    }
+
+    @Synchronized
+    fun started(id: String) {
+        val current = snapshots.getValue(id)
+        val running = current.copy(ready = false, phase = "running", startedAtMillis = elapsedMillis())
+        snapshots[id] = running
+        append("running", running)
+    }
+
+    @Synchronized
+    fun update(observed: DiagnosticSnapshot) {
+        if (!attached) return
+        val previous = snapshots[observed.id] ?: return
+        val start = previous.startedAtMillis ?: if (!observed.ready) elapsedMillis() else null
+        val phase = when {
+            !observed.ready -> "running"
+            !previous.ready -> "completed"
+            else -> "snapshot"
+        }
+        val next = observed.copy(
+            phase = phase,
+            requestId = previous.requestId,
+            startedAtMillis = start,
+            elapsedMillis = if (observed.ready && start != null) elapsedMillis() - start else null,
+        )
+        snapshots[next.id] = next
+        append(phase, next)
+    }
+
+    @Synchronized
+    fun failed(id: String, reason: String) {
+        val previous = snapshots.getValue(id)
+        val failed = previous.copy(
+            ready = true, phase = "error", severity = "INFO",
+            headline = "Diagnostic operation failed", report = reason,
+        )
+        snapshots[id] = failed
+        append("error", failed, reason)
+    }
+
+    @Synchronized
+    fun status(): List<DiagnosticSnapshot> = snapshots.values.toList()
+
+    @Synchronized
+    fun isAttached(): Boolean = attached
+
+    @Synchronized
+    fun read(after: Long): DiagnosticRead {
+        require(after >= 0)
+        val oldest = events.firstOrNull()?.sequence ?: sequence + 1
+        val reset = after > sequence
+        return DiagnosticRead(
+            instance, attached, sequence, oldest,
+            gap = !reset && after < oldest - 1,
+            reset = reset,
+            events = events.filter { reset || it.sequence > after },
+        )
+    }
+
+    private fun append(type: String, snapshot: DiagnosticSnapshot? = null, detail: String = "") {
+        // Event previews are bounded; status/report always expose the complete latest report.
+        val preview = snapshot?.copy(report = snapshot.report.take(EVENT_REPORT_LIMIT))
+        events.addLast(DiagnosticEvent(
+            ++sequence, epochMillis(), type, preview, detail,
+            reportTruncated = (snapshot?.report?.length ?: 0) > EVENT_REPORT_LIMIT,
+        ))
+        while (events.size > eventLimit) events.removeFirst()
+    }
+
+    companion object {
+        const val EVENT_REPORT_LIMIT = 16_384
+    }
+}
