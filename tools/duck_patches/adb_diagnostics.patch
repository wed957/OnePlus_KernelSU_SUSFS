diff --git a/tools/duck-debug.py b/tools/duck-debug.py
new file mode 100644
index 0000000..5f9e58a
--- /dev/null
+++ b/tools/duck-debug.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Inspect an opt-in Duck diagnostic build over an already authorized ADB connection."""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import time
+
+AUTHORITY = "content://com.eltavine.duckdetector.diagnostics"
+
+
+def detector_id(value):
+    if not re.fullmatch(r"[a-zA-Z0-9_.-]+", value):
+        raise argparse.ArgumentTypeError("Use a detector ID from status, or all.")
+    return value
+
+
+def find_adb():
+    command = shutil.which("adb")
+    if command:
+        return command
+    sdk = Path(os.environ.get("ANDROID_HOME", Path.home() / ".android-sdk"))
+    return str(sdk / "platform-tools" / ("adb.exe" if os.name == "nt" else "adb"))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--adb", default=find_adb())
+    parser.add_argument("--serial")
+    sub = parser.add_subparsers(dest="command", required=True)
+    sub.add_parser("status", help="List detector IDs and current state as JSON.")
+    scan = sub.add_parser("scan", help="Queue a rescan in the active app session.")
+    scan.add_argument("detector", nargs="?", default="all", type=detector_id)
+    report = sub.add_parser("report", help="Read the complete latest detector report.")
+    report.add_argument("detector", nargs="?", default="all", type=detector_id)
+    report.add_argument("--output", type=Path)
+    watch = sub.add_parser("watch", help="Follow scan events without instrumenting syscall loops.")
+    watch.add_argument("--detector", type=detector_id)
+    watch.add_argument("--details", action="store_true")
+    watch.add_argument("--json", action="store_true")
+    watch.add_argument("--interval", type=float, default=0.5)
+    watch.add_argument("--duration", type=float, default=0, help="Seconds; zero follows until Ctrl+C.")
+    args = parser.parse_args()
+    adb = [args.adb] + (["-s", args.serial] if args.serial else [])
+
+    def command(*arguments):
+        result = subprocess.run(adb + ["shell", "content", *arguments], capture_output=True, timeout=30)
+        output = result.stdout.decode("utf-8", errors="strict").replace("\r\n", "\n")
+        error = "\n".join(
+            line for line in result.stderr.decode("utf-8", errors="replace").splitlines()
+            if not line.startswith(("* daemon not running;", "* daemon started successfully"))
+        ).strip()
+        if result.returncode or error or output.startswith(("Error", "Exception")):
+            raise RuntimeError(error or output or "ADB failed.")
+        return output
+
+    def read(path):
+        return command("read", "--uri", AUTHORITY + "/" + path)
+
+    if args.command == "status":
+        print(json.dumps(json.loads(read("status")), ensure_ascii=False, indent=2))
+    elif args.command == "scan":
+        output = command("call", "--uri", AUTHORITY, "--method", "scan", "--arg", args.detector)
+        print(output, end="")
+        if "status=QUEUED" not in output:
+            return 2
+    elif args.command == "report":
+        text = read("report/" + args.detector)
+        if args.output:
+            args.output.write_text(text, encoding="utf-8")
+            print(str(args.output.resolve()))
+        else:
+            print(text, end="")
+    else:
+        if args.interval < 0.25 or args.duration < 0:
+            parser.error("interval must be at least 0.25 seconds; duration cannot be negative.")
+        after = 0
+        instance = None
+        started = time.monotonic()
+        while args.duration == 0 or time.monotonic() - started < args.duration:
+            records = [json.loads(line) for line in read("events?after=" + str(after)).splitlines() if line]
+            if not records or records[0].get("type") != "cursor" or records[0].get("protocol") != 1:
+                raise RuntimeError("Unsupported or missing diagnostic event header.")
+            cursor = records[0]
+            if cursor["gap"]:
+                print("Event history gap: older events were evicted; report retains full latest results.", file=sys.stderr)
+            if instance is not None and instance != cursor["instance"]:
+                print("App process restarted; following its new event sequence.", file=sys.stderr)
+            instance = cursor["instance"]
+            for event in records[1:]:
+                if args.detector and event.get("id") != args.detector:
+                    continue
+                if args.json:
+                    print(json.dumps({"instance": instance, **event}, ensure_ascii=False), flush=True)
+                else:
+                    print("#" + str(event["sequence"]) + " " + event.get("id", "app") + " " +
+                          event["type"] + " " + event.get("severity", "") + " " +
+                          str(event.get("elapsed_ms", "-")) + " ms", flush=True)
+                    if args.details and event.get("report"):
+                        print(event["report"], flush=True)
+                        if event["report_truncated"]:
+                            print("Preview truncated; use report " + event["id"] + " for the full result.", flush=True)
+            after = cursor["newest_sequence"]
+            time.sleep(args.interval)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.stdout.reconfigure(encoding="utf-8")
+    sys.stderr.reconfigure(encoding="utf-8")
+    try:
+        raise SystemExit(main())
+    except KeyboardInterrupt:
+        raise SystemExit(0)
+    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
+        print(str(error), file=sys.stderr)
+        raise SystemExit(1)
