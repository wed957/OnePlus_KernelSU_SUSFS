+package com.eltavine.duckdetector.diagnostics
+
+internal fun enforceDiagnosticCaller(enabled: Boolean, callerUid: Int, ownerUid: Int) {
+    // AID_ROOT=0 and AID_SHELL=2000; an app granted DUMP alone is not an ADB caller.
+    if (!enabled || callerUid !in setOf(0, 2000, ownerUid)) {
+        throw SecurityException("This diagnostic interface is restricted to ADB and the owning app.")
+    }
+}
