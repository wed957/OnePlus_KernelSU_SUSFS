+package com.eltavine.duckdetector.diagnostics
+
+import android.os.SystemClock
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import com.eltavine.duckdetector.BuildConfig
+import com.eltavine.duckdetector.core.scan.DetectorSummary
+import com.eltavine.duckdetector.core.ui.detector.DetectorSession
+import com.eltavine.duckdetector.features.dashboard.presentation.export.DashboardReportRenderer
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.launch
+
+/** Bridges the authorized app session to ADB; it never creates a scanner or grants a consent. */
+internal object AdbDiagnostics {
+    val store = DiagnosticStore(SystemClock::elapsedRealtime, System::currentTimeMillis)
+    private val connectionLock = Any()
+    private var connection: Channel<DiagnosticRequest>? = null
+
+    suspend fun observe(sessions: List<DetectorSession>) = coroutineScope {
+        val commands = Channel<DiagnosticRequest>(capacity = 1)
+        val byId = sessions.associateBy { it.id.value }
+        store.attach(sessions.map { snapshot(it.summary.value) })
+        sessions.forEach { session ->
+            launch(start = CoroutineStart.UNDISPATCHED) {
+                session.summary.collect { summary ->
+                    try {
+                        val report = if (summary.ready) {
+                            DashboardReportRenderer.renderDetector(session.report())
+                        } else {
+                            ""
+                        }
+                        store.update(snapshot(summary).copy(report = report))
+                    } catch (cancelled: CancellationException) {
+                        throw cancelled
+                    } catch (error: Exception) {
+                        store.failed(session.id.value, "Report export failed: " + (error.message ?: "no error detail"))
+                    }
+                }
+            }
+        }
+        synchronized(connectionLock) { connection = commands }
+        try {
+            for (command in commands) {
+                command.detectorIds.forEach { id ->
+                    store.started(id)
+                    try {
+                        // The UI's rescan entry point preserves ScanSessionRunner serialization.
+                        byId.getValue(id).rescan()
+                    } catch (cancelled: CancellationException) {
+                        throw cancelled
+                    } catch (error: Exception) {
+                        store.failed(id, "Scan dispatch failed: " + (error.message ?: "no error detail"))
+                    }
+                }
+            }
+        } finally {
+            synchronized(connectionLock) {
+                if (connection === commands) {
+                    connection = null
+                    store.detach()
+                }
+            }
+            commands.close()
+        }
+    }
+
+    fun requestScan(selection: DiagnosticSelection): DiagnosticRequest = synchronized(connectionLock) {
+        val channel = connection
+            ?: return@synchronized DiagnosticRequest(DiagnosticRequestStatus.NOT_READY, "Open the app and complete its startup choices.")
+        val request = store.request(selection)
+        if (request.status != DiagnosticRequestStatus.QUEUED) return@synchronized request
+        if (channel.trySend(request).isFailure) {
+            request.detectorIds.forEach { store.failed(it, "The app session disconnected before dispatch.") }
+            return@synchronized DiagnosticRequest(DiagnosticRequestStatus.NOT_READY, "The app session disconnected.")
+        }
+        request
+    }
+
+    private fun snapshot(summary: DetectorSummary) = DiagnosticSnapshot(
+        id = summary.id.value,
+        title = summary.title,
+        ready = summary.ready,
+        severity = summary.status.severity.name,
+        headline = summary.headline,
+    )
+}
+
+@Composable
+internal fun AdbDiagnosticEffect(sessions: List<DetectorSession>) {
+    if (BuildConfig.ADB_DIAGNOSTICS) {
+        LaunchedEffect(sessions) { AdbDiagnostics.observe(sessions) }
+    }
+}
