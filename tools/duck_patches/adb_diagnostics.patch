+package com.eltavine.duckdetector.diagnostics
+
+import android.content.ContentProvider
+import android.content.ContentValues
+import android.database.Cursor
+import android.database.MatrixCursor
+import android.net.Uri
+import android.os.Binder
+import android.os.Bundle
+import android.os.ParcelFileDescriptor
+import android.os.Process
+import com.eltavine.duckdetector.BuildConfig
+import java.io.FileNotFoundException
+
+/** Optional transport for "adb shell content"; installed only by an explicit build property. */
+class AdbDiagnosticProvider : ContentProvider() {
+    override fun onCreate(): Boolean = BuildConfig.ADB_DIAGNOSTICS
+
+    private fun enforceCaller() {
+        // AOSP ContentProvider.call/getType do not enforce per-operation read permissions.
+        enforceDiagnosticCaller(BuildConfig.ADB_DIAGNOSTICS, Binder.getCallingUid(), Process.myUid())
+    }
+
+    override fun call(method: String, arg: String?, extras: Bundle?): Bundle {
+        enforceCaller()
+        val result = when (method) {
+            "scan" -> AdbDiagnostics.requestScan(
+                if (arg == null || arg == "all") DiagnosticSelection.All else DiagnosticSelection.Single(arg),
+            )
+            else -> DiagnosticRequest(DiagnosticRequestStatus.UNKNOWN_METHOD, "Supported method: scan; read status for detector IDs.")
+        }
+        return Bundle().apply {
+            putString("status", result.status.name)
+            putString("message", result.message)
+            result.requestId?.let { putLong("request_id", it) }
+            putStringArrayList("detectors", ArrayList(result.detectorIds))
+        }
+    }
+
+    override fun openFile(uri: Uri, mode: String): ParcelFileDescriptor {
+        enforceCaller()
+        if (mode != "r") throw FileNotFoundException("Diagnostics are read-only.")
+        val store = AdbDiagnostics.store
+        val body = when (uri.pathSegments.firstOrNull()) {
+            "status" -> {
+                require(uri.pathSegments.size == 1)
+                DiagnosticWireFormat.status(store)
+            }
+            "events" -> {
+                require(uri.pathSegments.size == 1)
+                val value = uri.getQueryParameter("after")
+                val after = if (value == null) 0L else value.toLongOrNull()
+                    ?: throw FileNotFoundException("after must be a non-negative integer.")
+                if (after < 0) throw FileNotFoundException("after must be a non-negative integer.")
+                DiagnosticWireFormat.events(store, after)
+            }
+            "report" -> {
+                require(uri.pathSegments.size in 1..2)
+                val id = uri.pathSegments.getOrNull(1) ?: "all"
+                val selected = store.status().filter { id == "all" || it.id == id }
+                if (selected.isEmpty()) throw FileNotFoundException("No report for this detector; read status.")
+                buildString {
+                    appendLine(DiagnosticWireFormat.metadata(store).toString())
+                    selected.forEach {
+                        appendLine("Detector: " + it.id + "; phase=" + it.phase + "; request=" + it.requestId)
+                        appendLine(if (it.ready) it.report else "No completed result for the current scan.")
+                    }
+                }
+            }
+            else -> throw FileNotFoundException("Supported paths: status, events, report/<id>.")
+        }
+        return openPipeHelper(uri, getType(uri), null, body) { descriptor, _, _, _, text ->
+            ParcelFileDescriptor.AutoCloseOutputStream(descriptor).bufferedWriter(Charsets.UTF_8).use {
+                it.write(text)
+            }
+        }
+    }
+
+    override fun query(
+        uri: Uri, projection: Array<out String>?, selection: String?,
+        selectionArgs: Array<out String>?, sortOrder: String?,
+    ): Cursor {
+        enforceCaller()
+        if (uri.path != "/status") throw IllegalArgumentException("Query supports only /status.")
+        return MatrixCursor(arrayOf("id", "ready", "phase", "severity", "headline")).apply {
+            AdbDiagnostics.store.status().forEach {
+                addRow(arrayOf<Any>(it.id, if (it.ready) 1 else 0, it.phase, it.severity, it.headline))
+            }
+        }
+    }
+
+    override fun getType(uri: Uri): String {
+        enforceCaller()
+        return when (uri.pathSegments.firstOrNull()) {
+            "status" -> "application/json"
+            "events" -> "application/x-ndjson"
+            else -> "text/plain"
+        }
+    }
+
+    override fun insert(uri: Uri, values: ContentValues?): Uri? = rejectWrite()
+    override fun update(uri: Uri, values: ContentValues?, selection: String?, selectionArgs: Array<out String>?): Int =
+        rejectWrite()
+    override fun delete(uri: Uri, selection: String?, selectionArgs: Array<out String>?): Int = rejectWrite()
+
+    private fun rejectWrite(): Nothing {
+        enforceCaller()
+        throw UnsupportedOperationException("Diagnostics do not accept database writes.")
+    }
+}
