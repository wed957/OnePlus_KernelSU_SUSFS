+
+package com.eltavine.duckdetector.diagnostics
+
+import android.os.Process
+import com.eltavine.duckdetector.BuildConfig
+import org.json.JSONArray
+import org.json.JSONObject
+
+internal object DiagnosticWireFormat {
+    fun metadata(store: DiagnosticStore): JSONObject = JSONObject()
+        .put("protocol", 1)
+        .put("instance", store.instance)
+        .put("attached", store.isAttached())
+        .put("version", BuildConfig.VERSION_NAME)
+        .put("build_time_utc", BuildConfig.BUILD_TIME_UTC)
+        .put("app_uid", Process.myUid())
+        .put("app_pid", Process.myPid())
+
+    fun status(store: DiagnosticStore): String = metadata(store)
+        .put("detectors", JSONArray(store.status().map { snapshot(it, includeReport = false) }))
+        .toString() + "\n"
+
+    fun events(store: DiagnosticStore, after: Long): String {
+        val read = store.read(after)
+        return buildString {
+            appendLine(metadata(store)
+                .put("type", "cursor")
+                .put("attached", read.attached)
+                .put("oldest_sequence", read.oldestSequence)
+                .put("newest_sequence", read.newestSequence)
+                .put("gap", read.gap)
+                .put("reset", read.reset)
+                .toString())
+            read.events.forEach { event ->
+                val value = event.snapshot?.let { snapshot(it, includeReport = true) } ?: JSONObject()
+                appendLine(value
+                    .put("sequence", event.sequence)
+                    .put("epoch_ms", event.epochMillis)
+                    .put("type", event.type)
+                    .put("detail", event.detail)
+                    .put("report_truncated", event.reportTruncated)
+                    .toString())
+            }
+        }
+    }
+
+    private fun snapshot(value: DiagnosticSnapshot, includeReport: Boolean): JSONObject = JSONObject()
+        .put("id", value.id)
+        .put("title", value.title)
+        .put("ready", value.ready)
+        .put("phase", value.phase)
+        .put("severity", value.severity)
+        .put("headline", value.headline)
+        .put("request_id", value.requestId ?: JSONObject.NULL)
+        .put("elapsed_ms", value.elapsedMillis ?: JSONObject.NULL)
+        .apply { if (includeReport) put("report", value.report) }
+}
