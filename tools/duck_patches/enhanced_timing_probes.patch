+"""Exercise production supercall control flow with fake OS boundaries on any host."""
+import os
+import shutil
+import subprocess
+import tempfile
+from pathlib import Path
+
+root = Path(__file__).resolve().parent
+compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++")
+if not compiler:
+    raise RuntimeError("Host C++ compiler is required")
+with tempfile.TemporaryDirectory(prefix="ksu-supercall-test-") as directory:
+    work = Path(directory)
+    # The test supplies all declarations and fakes these APIs. Empty headers keep
+    # a host libc from replacing the Android-specific boundary under test.
+    for name in ("poll.h", "sys/ioctl.h", "sys/syscall.h", "sys/wait.h", "common/seccomp_child.h"):
+        path = work / name
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text("#pragma once\n", encoding="utf-8")
+    executable = work / ("supercall-test.exe" if os.name == "nt" else "supercall-test")
+    subprocess.run([
+        compiler, "-std=c++17", "-Wall", "-Wextra", "-Werror",
+        "-I", str(work), "-I", str(root.parents[1] / "main" / "cpp"),
+        str(root / "ksu_supercall_probe_test.cpp"), "-o", str(executable),
+    ], check=True)
+    subprocess.run([str(executable)], check=True, timeout=10)
