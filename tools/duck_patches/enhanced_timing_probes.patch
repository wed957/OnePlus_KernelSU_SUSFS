diff --git a/feature/nativeroot/data/src/test/native/ksu_supercall_probe_test.cpp b/feature/nativeroot/data/src/test/native/ksu_supercall_probe_test.cpp
new file mode 100644
index 00000000..13a31a25
--- /dev/null
+++ b/feature/nativeroot/data/src/test/native/ksu_supercall_probe_test.cpp
@@ -0,0 +1,219 @@
+/*
+ * Copyright 2026 Duck Apps Contributor
+ * Licensed under the Apache License, Version 2.0.
+ */
+// All process and syscall operations are fakes. Android ABI compilation is a separate check.
+#include <cassert>
+#include <cerrno>
+#include <csignal>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <iostream>
+#include <string>
+#include <sys/types.h>
+#include <time.h>
+#include <unistd.h>
+#include <vector>
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0x80000
+#endif
+#ifndef O_NONBLOCK
+#define O_NONBLOCK 0x800
+#endif
+#ifndef SIGKILL
+#define SIGKILL 9
+#endif
+#ifndef SIGSYS
+#define SIGSYS 31
+#endif
+#ifndef CLOCK_MONOTONIC
+#define CLOCK_MONOTONIC 1
+#endif
+#define WNOHANG 1
+#define WIFEXITED(s) (((s) & 0x7f) == 0)
+#define WEXITSTATUS(s) (((s) >> 8) & 0xff)
+#define WIFSIGNALED(s) (((s) & 0x7f) != 0)
+#define WTERMSIG(s) ((s) & 0x7f)
+#define _IOC_READ 2U
+#define _IOC(dir, type, number, size) (((dir) << 30) | ((size) << 16) | ((type) << 8) | (number))
+#define __NR_reboot 142
+
+static bool child_phase, hung, killed, interrupt_wait, short_read;
+static int child_exit, syscall_errno, info_errno, close_driver, wait_calls;
+static bool install_fd, info_valid;
+static std::int64_t clock_ms;
+static std::vector<unsigned char> packet_bytes;
+static std::vector<int> closed_fds;
+struct ChildExit { int status; };
+
+namespace duckdetector::common {
+    inline bool install_seccomp_trap_exit() { return true; }
+    inline bool seccomp_trapped(int status) {
+        return (WIFEXITED(status) && WEXITSTATUS(status) == 125) ||
+               (WIFSIGNALED(status) && WTERMSIG(status) == SIGSYS);
+    }
+}
+
+static int test_pipe2(int* fds, int flags) {
+    assert((flags & O_CLOEXEC) != 0 && (flags & O_NONBLOCK) != 0);
+    fds[0] = 10; fds[1] = 11;
+    return 0;
+}
+static pid_t test_fork() { return child_phase ? 0 : 77; }
+static int test_close(int fd) {
+    if (fd == 40) ++close_driver;
+    closed_fds.push_back(fd);
+    return 0;
+}
+static long test_syscall(long number, unsigned int magic1, unsigned int magic2, int cmd, int* fd) {
+    assert(number == __NR_reboot && magic1 == 0xDEADBEEF && magic2 == 0xCAFEBABE);
+    assert(cmd == 0 && *fd == -1);
+    if (install_fd) *fd = 40;
+    errno = syscall_errno;
+    return syscall_errno ? -1 : 0;
+}
+static int test_ioctl(int fd, unsigned long request, void* data) {
+    assert(fd == 40);
+    if (request == _IOC(_IOC_READ, 'K', 2, 0)) {
+        const std::uint32_t response[] = {info_valid ? 60000U : 0U, 0, 32};
+        if (!info_errno) std::memcpy(data, response, sizeof(response));
+        errno = info_errno;
+        return info_errno ? -1 : 0;
+    }
+    errno = ENOTTY;
+    return -1;
+}
+static ssize_t test_write(int fd, const void* data, size_t size) {
+    assert(fd == 11);
+    const auto* bytes = static_cast<const unsigned char*>(data);
+    packet_bytes.assign(bytes, bytes + size);
+    return static_cast<ssize_t>(size);
+}
+static ssize_t test_read(int fd, void* data, size_t size) {
+    assert(fd == 10);
+    if (packet_bytes.empty()) return 0;
+    assert(packet_bytes.size() == size);
+    std::memcpy(data, packet_bytes.data(), size);
+    return static_cast<ssize_t>(short_read ? size - 1 : size);
+}
+[[noreturn]] static void test_exit(int status) { throw ChildExit{status}; }
+static pid_t test_waitpid(pid_t pid, int* status, int options) {
+    assert(pid == 77);
+    ++wait_calls;
+    if (interrupt_wait && wait_calls == 1) { errno = EINTR; return -1; }
+    if (hung && !killed) { assert(options == WNOHANG); return 0; }
+    *status = killed ? SIGKILL : child_exit << 8;
+    return pid;
+}
+static int test_kill(pid_t pid, int signal) {
+    assert(pid == 77 && signal == SIGKILL);
+    killed = true;
+    return 0;
+}
+static int test_clock_gettime(int, timespec* time) {
+    time->tv_sec = static_cast<time_t>(clock_ms / 1000);
+    time->tv_nsec = static_cast<long>(clock_ms % 1000 * 1000000);
+    return 0;
+}
+static int test_poll(void*, unsigned long, int timeout) { clock_ms += timeout; return 0; }
+
+#define pipe2 test_pipe2
+#define fork test_fork
+#define close test_close
+#define syscall test_syscall
+#define ioctl test_ioctl
+#define write test_write
+#define read test_read
+#define _exit test_exit
+#define waitpid test_waitpid
+#define kill test_kill
+#define clock_gettime test_clock_gettime
+#define poll test_poll
+#include "../../main/cpp/nativeroot/probes/ksu_supercall_probe.cpp"
+
+static void reset() {
+    child_phase = hung = killed = interrupt_wait = short_read = false;
+    install_fd = info_valid = true;
+    child_exit = syscall_errno = info_errno = close_driver = wait_calls = 0;
+    clock_ms = 100;
+    packet_bytes.clear();
+    closed_fds.clear();
+}
+static void collect_child() {
+    child_phase = true;
+    duckdetector::nativeroot::KsuSupercallPacket packet{};
+    int error = 0;
+    try {
+        duckdetector::nativeroot::collect_child_packet(packet, error);
+        assert(false);
+    } catch (const ChildExit& exit) {
+        child_exit = exit.status;
+    }
+    child_phase = false;
+    closed_fds.clear();
+}
+static duckdetector::nativeroot::ProbeResult collect_parent() {
+    auto result = duckdetector::nativeroot::run_ksu_supercall_probe();
+    assert(closed_fds == std::vector<int>({11, 10}));
+    return result;
+}
+
+int main() {
+    reset();
+    collect_child();
+    assert(close_driver == 1);
+    auto result = collect_parent();
+    assert(result.flags.kernel_su && result.hit_count == 1 && result.numeric_value == 60000);
+    std::cout << "PASS correct UAPI, validated GET_INFO and driver cleanup\n";
+
+    for (int error : {EPERM, EINVAL}) {
+        reset();
+        syscall_errno = error;
+        install_fd = false;
+        collect_child();
+        result = collect_parent();
+        assert(!result.flags.kernel_su && result.hit_count == 0);
+        assert(result.findings[0].value == (error == EPERM ? "Permission limited" : "No protocol response"));
+        assert(result.findings[0].detail.find("errno=" + std::to_string(error)) != std::string::npos);
+        assert(close_driver == 0);
+    }
+    std::cout << "PASS EPERM and EINVAL stay distinct without a positive finding\n";
+
+    reset();
+    info_valid = false;
+    collect_child();
+    result = collect_parent();
+    assert(!result.flags.kernel_su && result.checked_count == 0 && close_driver == 1);
+    reset();
+    info_errno = EFAULT;
+    collect_child();
+    result = collect_parent();
+    assert(!result.flags.kernel_su && result.checked_count == 0 && close_driver == 1);
+    std::cout << "PASS invalid GET_INFO responses are unavailable and close their fd\n";
+
+    reset();
+    child_exit = 125;
+    result = collect_parent();
+    assert(result.denied_count == 1 && !result.flags.kernel_su && !killed);
+    std::cout << "PASS a trapped child reports seccomp restriction without killing the caller\n";
+
+    reset();
+    hung = true;
+    result = collect_parent();
+    assert(killed && wait_calls > 1 && clock_ms <= 2105);
+    assert(result.checked_count == 0 && result.findings[0].value == "Timed out");
+    std::cout << "PASS timeout terminates and reaps the child\n";
+
+    reset();
+    collect_child();
+    interrupt_wait = true;
+    result = collect_parent();
+    assert(result.flags.kernel_su && wait_calls == 2);
+    reset();
+    collect_child();
+    short_read = true;
+    result = collect_parent();
+    assert(!result.flags.kernel_su && result.findings[0].value == "Unavailable");
+    std::cout << "PASS interrupted wait and truncated pipe response handling\n";
+}
