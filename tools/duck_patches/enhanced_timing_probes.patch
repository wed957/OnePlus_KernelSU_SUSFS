+++ b/feature/selinux/data/src/test/native/attr_timing_probe_test.cpp
@@ -0,0 +1,190 @@
+/*
+ * Copyright 2026 Duck Apps Contributor
+ * Licensed under the Apache License, Version 2.0.
+ */
+// Exercise the real sampler with deterministic clocks and no process-context writes.
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cerrno>
+#include <cstdint>
+#include <cstring>
+#include <fcntl.h>
+#include <iostream>
+#include <sstream>
+#include <string>
+#include <time.h>
+#include <unistd.h>
+#include <vector>
+
+#ifndef O_CLOEXEC
+#define O_CLOEXEC 0
+#endif
+#ifndef CLOCK_MONOTONIC_RAW
+#define CLOCK_MONOTONIC_RAW 4
+#endif
+
+static uint64_t ticks;
+static int fast_variant, error_variant, success_at;
+static bool transient_signal, write_succeeded;
+static int opened, closed;
+static int parser_error, parser_final_error, parser_calls;
+static std::array<int, 4> control_calls;
+static std::vector<int> writes;
+static constexpr char context[] = "u:r:untrusted_app:s0:c1,c2";
+
+static unsigned test_getuid() { return 10001; }
+static int test_open(const char*, int) { ++opened; return 17; }
+static int test_close(int) { ++closed; return 0; }
+static ssize_t test_read(int, void* buffer, size_t size) {
+    assert(size >= sizeof(context));
+    std::memcpy(buffer, context, sizeof(context) - 1);
+    return sizeof(context) - 1;
+}
+static int test_clock_gettime(int, timespec* out) {
+    out->tv_sec = static_cast<time_t>(ticks / 1000000000ULL);
+    out->tv_nsec = static_cast<long>(ticks % 1000000000ULL);
+    return 0;
+}
+static ssize_t test_write(int, const void* buffer, size_t length) {
+    assert(!write_succeeded);
+    const auto* data = static_cast<const char*>(buffer);
+    if (std::string(data, length) == "duckdetector_invalid_context") {
+        ++parser_calls;
+        ticks += 1000;
+        errno = parser_calls == 1 ? parser_error : parser_final_error;
+        if (errno == 0) {
+            write_succeeded = true;
+            return static_cast<ssize_t>(length);
+        }
+        return -1;
+    }
+    int variant = -1;
+    if (data[0] == '\0') variant = 1;
+    else if (data[0] == '\n') variant = data[1] == ':' ? 0 : data[1] == 'A' ? 2 : 3;
+    writes.push_back(variant);
+    if (variant >= 0) ++control_calls[variant];
+    bool fast = variant >= 0 && (fast_variant == -2 || fast_variant == variant);
+    if (transient_signal && variant >= 0 && control_calls[variant] > 289) fast = false;
+    ticks += fast ? 100 : 1000;
+    if (static_cast<int>(writes.size()) == success_at) {
+        write_succeeded = true;
+        return static_cast<ssize_t>(length);
+    }
+    errno = variant >= 0 && (error_variant == -2 || error_variant == variant) ? EINVAL : EACCES;
+    return -1;
+}
+
+#define getuid test_getuid
+#define open test_open
+#define close test_close
+#define read test_read
+#define write test_write
+#define clock_gettime test_clock_gettime
+#include "../../main/cpp/selinux/attr_timing_probe.cpp"
+
+static std::string field(const std::string& payload, const std::string& key) {
+    const auto begin = ("\n" + payload).find("\n" + key + "=");
+    if (begin == std::string::npos) return "";
+    const auto value = begin + key.size() + 1;
+    return payload.substr(value, payload.find('\n', value) - value);
+}
+
+static std::string run(int fast = -1, int error = -1, bool transient = false, int success = -1,
+                       int parser = EINVAL, int final_parser = EINVAL) {
+    ticks = 1000000;
+    fast_variant = fast;
+    error_variant = error;
+    transient_signal = transient;
+    success_at = success;
+    write_succeeded = false;
+    opened = closed = 0;
+    parser_error = parser;
+    parser_final_error = final_parser;
+    parser_calls = 0;
+    control_calls.fill(0);
+    writes.clear();
+    auto payload = duckdetector::selinux::collect_attr_timing_probe();
+    assert(opened == closed);
+    return payload;
+}
+
+int main() {
+    auto result = run();
+    assert(field(result, "VERSION") == "2");
+    assert(field(result, "STATE") == "NO_SIGNAL");
+    assert(parser_calls == 2);
+    // Each independent window has a BA preflight, 32 warmup and 256 measured pairs.
+    assert(writes.size() == 4 * 578);
+    for (int variant = 0; variant < 4; ++variant) {
+        assert(control_calls[variant] == 289);
+        assert(field(result, "V" + std::to_string(variant) + "_PAIRS") == "256");
+        for (int pair = 0; pair < 256; ++pair) {
+            const size_t index = variant * 578 + 66 + pair * 2;
+            assert(writes[index] == (pair % 2 == 0 ? -1 : variant));
+            assert(writes[index + 1] == (pair % 2 == 0 ? variant : -1));
+        }
+    }
+    std::cout << "PASS clean controls and balanced per-variant sampling\n";
+
+    for (int variant = 0; variant < 4; ++variant) {
+        result = run(variant);
+        const auto prefix = "V" + std::to_string(variant) + "_";
+        assert(field(result, "STATE") == "CANDIDATE");
+        assert(field(result, prefix + "A_SLOWER") == "256");
+        assert(field(result, prefix + "DELTA_MEDIAN_NS") == "900");
+        assert(field(result, prefix + "RECHECK_STATE") == "CANDIDATE");
+        assert(control_calls[variant] == 578);
+    }
+    std::cout << "PASS each single-variant signal survives three negative controls and confirms\n";
+
+    result = run(0, 1);
+    assert(field(result, "STATE") == "CANDIDATE");
+    assert(field(result, "V0_RECHECK_STATE") == "CANDIDATE");
+    assert(field(result, "V1_STATE") == "UNAVAILABLE");
+    assert(control_calls[1] == 1 && control_calls[2] == 289);
+    std::cout << "PASS original signal survives EINVAL in an added variant\n";
+
+    result = run(-1, 1);
+    assert(field(result, "STATE") == "INCONCLUSIVE");
+    assert(field(result, "V2_STATE") == "NO_SIGNAL");
+    result = run(-1, -2);
+    assert(field(result, "STATE") == "UNAVAILABLE");
+    std::cout << "PASS partial and fully unavailable coverage stay explicit\n";
+
+    result = run(1, -1, true);
+    assert(field(result, "STATE") == "INCONCLUSIVE");
+    assert(field(result, "V1_STATE") == "CANDIDATE");
+    assert(field(result, "V1_RECHECK_STATE") == "NO_SIGNAL");
+    std::cout << "PASS a transient candidate fails confirmation\n";
+
+    for (int success : {1, 2, 3, 4, 5, 6, 579, 4 * 578 + 1}) {
+        result = run(0, -1, false, success);
+        assert(field(result, "STATE") == "UNAVAILABLE");
+        assert(write_succeeded && static_cast<int>(writes.size()) == success);
+        assert(field(result, "REASON").find("write succeeded") != std::string::npos);
+    }
+    std::cout << "PASS any successful write immediately stops all variants, including rechecks\n";
+
+    result = run(0, -1, false, -1, EACCES);
+    assert(field(result, "STATE") == "UNAVAILABLE");
+    assert(field(result, "REASON").find("EACCES (13)") != std::string::npos);
+    assert(field(result, "REASON").find("SETCURRENT") != std::string::npos);
+    assert(parser_calls == 1 && writes.empty());
+    std::cout << "PASS denial before context parsing cannot become negative timing evidence\n";
+
+    for (int error : {EPERM, EIO, 0}) {
+        result = run(0, -1, false, -1, error);
+        assert(field(result, "STATE") == "UNAVAILABLE");
+        assert(parser_calls == 1 && writes.empty());
+        assert(write_succeeded == (error == 0));
+    }
+    std::cout << "PASS unexpected parser controls and successful writes stop before sampling\n";
+
+    result = run(0, -1, false, -1, EINVAL, EACCES);
+    assert(field(result, "STATE") == "UNAVAILABLE");
+    assert(field(result, "REASON").find("Final malformed-context control") != std::string::npos);
+    assert(field(result, "V0_STATE").empty());
+    assert(parser_calls == 2 && control_calls[0] == 578);
+    std::cout << "PASS lost parser coverage invalidates an otherwise reproducible timing candidate\n";
+}
